{
  "name": "NIPE - Narrative Intelligence & Performance Engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:regression": "vitest run tests/regression",
    "test:vitest": "vitest run",
    "test:e2e": "playwright test --config tests/playwright/playwright.config.ts --project=e2e",
    "test:visual": "playwright test --config tests/playwright/playwright.config.ts --project=visual",
    "test:frontend": "npm run test:vitest && npm run test:e2e && npm run test:visual"
